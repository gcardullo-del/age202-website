generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  country         String?
  biography       String?
  heroImage       String?
  portraitImage   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  accent          String               @default("#C8FF00")
  active          Boolean              @default(true)
  collectionType  PlayerCollectionType @default(ARCHIVE)
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  openGraphImage  String?

  robotsIndex  Boolean @default(true)
  robotsFollow Boolean @default(true)

  publishedAt  DateTime?
  debutYear    Int?
  displayOrder Int?
  firstName    String?
  lastName     String?
  nickname     String?
  quote        String?

  artifacts           Artifact[]
  memorabilia         Memorabilia[]
  atpPlayer           AtpPlayer?
  playerProfile       PlayerProfile?
  careerEvents        PlayerCareerEvent[]
  museumCollections   MuseumCollectionPlayer[]
  equipment           PlayerEquipment[]
  tournamentWins      TournamentEdition[]      @relation("TournamentEditionChampion")
  tournamentRunnerUps TournamentEdition[]      @relation("TournamentEditionRunnerUp")
  tournamentChampions TournamentChampion[]

  @@index([name])
  @@index([collectionType])
  @@index([displayOrder])
  @@index([active])
  @@index([debutYear])
}

model PlayerProfile {
  id               String    @id @default(cuid())
  playerId         String    @unique
  birthDate        DateTime?
  birthPlace       String?
  residence        String?
  height           Int?
  weight           Int?
  plays            String?
  backhand         String?
  coach            String?
  turnedPro        Int?
  careerHigh       Int?
  atpTitles        Int       @default(0)
  australianOpen   Int       @default(0)
  rolandGarros     Int       @default(0)
  wimbledon        Int       @default(0)
  usOpen           Int       @default(0)
  grandSlams       Int       @default(0)
  masters1000      Int       @default(0)
  atpFinals        Int       @default(0)
  olympicGold      Int       @default(0)
  davisCup         Int       @default(0)
  prizeMoney       Decimal?  @db.Decimal(15, 2)
  playingStyle     String?
  favouriteSurface String?
  biographyShort   String?
  biographyLong    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  player           Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model PlayerEquipment {
  id          String                  @id @default(cuid())
  playerId    String
  category    PlayerEquipmentCategory
  name        String
  brand       String?
  period      String?
  description String?
  curiosity   String?
  imageUrl    String?
  featured    Boolean                 @default(false)
  sortOrder   Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, category, name])
  @@index([playerId])
  @@index([category])
  @@index([featured])
  @@index([sortOrder])
}

model PlayerCareerEvent {
  id          String              @id @default(cuid())
  playerId    String
  year        Int
  month       Int?
  day         Int?
  title       String
  subtitle    String?
  description String?
  category    CareerEventCategory @default(MILESTONE)
  imageUrl    String?
  location    String?
  tournament  String?
  featured    Boolean             @default(false)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([playerId, year])
  @@index([playerId, sortOrder])
  @@index([category])
  @@index([featured])
  @@index([year])
}

model Brand {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  logo      String?
  history   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  artifacts Artifact[]

  @@index([name])
}

model Artifact {
  id                String               @id @default(cuid())
  archiveNumber     String               @unique
  title             String
  slug              String               @unique
  description       String?
  year              Int?
  size              String?
  colour            String?
  material          String?
  condition         ArtifactCondition
  status            ArtifactStatus       @default(DRAFT)
  featured          Boolean              @default(false)
  playerId          String
  brandId           String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  authentic         Boolean              @default(false)
  authenticityCode  String?              @unique
  availability      ArtifactAvailability @default(COMING_SOON)
  category          ArtifactCategory?
  collection        String?
  curatorNote       String?
  currency          String               @default("EUR")
  edition           String?
  historicalContext String?
  metaDescription   String?
  metaTitle         String?
  museumStory       String?
  price             Decimal?             @db.Decimal(10, 2)
  publishedAt       DateTime?
  rarity            ArtifactRarity       @default(COMMON)
  season            String?
  subtitle          String?
  tags              String[]             @default([])
  tournament        String?
  tournamentId      String?
  vintage           Boolean              @default(false)
  vintedUrl         String?

  brand            Brand       @relation(fields: [brandId], references: [id])
  player           Player      @relation(fields: [playerId], references: [id])
  tournamentRecord Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  images            ArtifactImage[]
  certificate       Certificate?
  museumCollections MuseumCollectionArtifact[]
  orderItems        OrderItem[]

  stripeProductId String? @unique
  stripePriceId   String? @unique
  stripeActive    Boolean @default(false)

  @@index([playerId])
  @@index([brandId])
  @@index([status])
  @@index([availability])
  @@index([category])
  @@index([rarity])
  @@index([featured])
  @@index([publishedAt])
  @@index([year])
  @@index([tournament])
  @@index([tournamentId])
  @@index([collection])
  @@index([createdAt])
}

model ArtifactImage {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  artifactId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@index([sortOrder])
  @@index([isCover])
}

model Certificate {
  id         String   @id @default(cuid())
  code       String   @unique
  issuedAt   DateTime @default(now())
  verified   Boolean  @default(true)
  curator    String?
  notes      String?
  qrCodeUrl  String?
  artifactId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([issuedAt])
  @@index([verified])
  @@index([createdAt])
}

model Memorabilia {
  id              String                  @id @default(cuid())
  inventoryNumber String                  @unique
  title           String
  subtitle        String?
  slug            String                  @unique
  description     String?
  type            MemorabiliaType
  status          MemorabiliaStatus       @default(DRAFT)
  availability    MemorabiliaAvailability @default(COMING_SOON)
  condition       MemorabiliaCondition?
  rarity          MemorabiliaRarity       @default(COMMON)
  featured        Boolean                 @default(false)
  displayOrder    Int?

  playerId String?
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  year         Int?
  brand        String?
  collection   String?
  edition      String?
  serialNumber String?

  cardSet           String?
  cardNumber        String?
  gradingCompany    String?
  grade             String?
  gradingCertNumber String? @unique

  signed            Boolean @default(false)
  signedBy          String?
  signatureLocation String?

  authentic             Boolean @default(false)
  authenticationCompany String?
  authenticityCode      String? @unique
  certificateUrl        String?

  material String?
  size     String?
  colour   String?

  price    Decimal? @db.Decimal(10, 2)
  currency String   @default("EUR")

  tags            String[]  @default([])
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?

  stripeProductId String? @unique
  stripePriceId   String? @unique
  stripeActive    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     MemorabiliaImage[]
  orderItems OrderItem[]

  @@index([type])
  @@index([status])
  @@index([availability])
  @@index([condition])
  @@index([rarity])
  @@index([featured])
  @@index([displayOrder])
  @@index([playerId])
  @@index([year])
  @@index([brand])
  @@index([collection])
  @@index([signed])
  @@index([authentic])
  @@index([publishedAt])
  @@index([createdAt])
}

model MemorabiliaImage {
  id            String   @id @default(cuid())
  url           String
  alt           String?
  sortOrder     Int      @default(0)
  isCover       Boolean  @default(false)
  memorabiliaId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memorabilia Memorabilia @relation(fields: [memorabiliaId], references: [id], onDelete: Cascade)

  @@index([memorabiliaId])
  @@index([sortOrder])
  @@index([isCover])
}

model OriginalProduct {
  id                String                      @id @default(cuid())
  title             String
  subtitle          String?
  slug              String                      @unique
  description       String?
  collection        String?
  edition           String?
  category          OriginalProductCategory
  material          String?
  colour            String?
  sizes             String[]                    @default([])
  tags              String[]                    @default([])
  price             Decimal?                    @db.Decimal(10, 2)
  currency          String                      @default("EUR")
  vintedUrl         String?
  availability      OriginalProductAvailability @default(COMING_SOON)
  status            OriginalProductStatus       @default(DRAFT)
  featured          Boolean                     @default(false)
  displayOrder      Int?
  metaTitle         String?
  metaDescription   String?
  publishedAt       DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  images            OriginalProductImage[]
  museumCollections MuseumCollectionOriginal[]
  orderItems        OrderItem[]

  stripeProductId String? @unique
  stripePriceId   String? @unique
  stripeActive    Boolean @default(false)

  @@index([category])
  @@index([availability])
  @@index([status])
  @@index([featured])
  @@index([displayOrder])
  @@index([publishedAt])
  @@index([collection])
  @@index([createdAt])
}

model Order {
  id String @id @default(cuid())

  orderNumber   String        @unique
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  isTest        Boolean       @default(true)

  currency String  @default("EUR")
  subtotal Decimal @db.Decimal(10, 2)
  shipping Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  customerEmail String
  customerName  String?
  customerPhone String?

  shippingName       String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingPostalCode String?
  shippingState      String?
  shippingCountry    String?

  shippingProvider ShippingProvider?
  shippingMethod   ShippingMethod?
  shippingStatus   ShippingStatus    @default(NOT_CREATED)

  inpostPointId      String?
  inpostPointName    String?
  inpostPointAddress String?

  inpostShipmentId     String? @unique
  inpostTrackingNumber String? @unique
  inpostStatus         String?
  inpostLabelUrl       String?

  shippingCreatedAt DateTime?
  labelCreatedAt    DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeCustomerId        String?

  paidAt      DateTime?
  preparingAt DateTime?
  cancelledAt DateTime?
  fulfilledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([paymentStatus])
  @@index([isTest])
  @@index([customerEmail])
  @@index([createdAt])
  @@index([stripeCustomerId])
  @@index([shippingProvider])
  @@index([shippingMethod])
  @@index([shippingStatus])
  @@index([inpostPointId])
  @@index([inpostStatus])
}

model OrderItem {
  id String @id @default(cuid())

  orderId           String
  artifactId        String?
  memorabiliaId     String?
  originalProductId String?

  itemType    OrderItemType
  productName String
  productSlug String?
  quantity    Int           @default(1)
  unitPrice   Decimal       @db.Decimal(10, 2)
  totalPrice  Decimal       @db.Decimal(10, 2)
  currency    String        @default("EUR")
  size        String?

  stripePriceId   String?
  stripeProductId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artifact        Artifact?        @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  memorabilia     Memorabilia?     @relation(fields: [memorabiliaId], references: [id], onDelete: SetNull)
  originalProduct OriginalProduct? @relation(fields: [originalProductId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([artifactId])
  @@index([memorabiliaId])
  @@index([originalProductId])
  @@index([itemType])
  @@index([stripePriceId])
}

model OriginalProductImage {
  id                String          @id @default(cuid())
  url               String
  alt               String?
  sortOrder         Int             @default(0)
  isCover           Boolean         @default(false)
  originalProductId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  originalProduct   OriginalProduct @relation(fields: [originalProductId], references: [id], onDelete: Cascade)

  @@index([originalProductId])
  @@index([sortOrder])
  @@index([isCover])
}

model AtpPlayer {
  id           String  @id
  rank         Int
  previousRank Int?
  name         String
  firstName    String?
  lastName     String?
  slug         String  @unique
  country      String
  countryCode  String
  points       Int?
  age          Int?
  imageUrl     String?

  playerId String? @unique
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  rankingDate DateTime @default(now())
  source      String   @default("AGE202")
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rank])
  @@index([rank, active])
  @@index([active])
  @@index([countryCode])
  @@index([name])
  @@index([points])
  @@index([previousRank])
  @@index([rankingDate])
}

model MediaFolder {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assets      MediaAsset[]

  @@index([name])
  @@index([createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  title        String
  alt          String?
  originalName String
  url          String
  mimeType     String
  extension    String
  size         Int
  width        Int?
  height       Int?
  tags         String[] @default([])
  folderId     String?
  isUsed       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  folder               MediaFolder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  heroForCollections   MuseumCollection[]      @relation("MuseumCollectionHeroMedia")
  museumCollections    MuseumCollectionMedia[]
  tennisHistoryEntries TennisHistoryEntry[]
  collaborations       Collaboration[]

  @@index([title])
  @@index([originalName])
  @@index([mimeType])
  @@index([extension])
  @@index([folderId])
  @@index([isUsed])
  @@index([createdAt])
}

model TennisHistoryEntry {
  id        String                 @id @default(cuid())
  type      TennisHistoryEntryType
  slug      String                 @unique
  year      Int
  month     Int?
  day       Int?
  sortOrder Int                    @default(0)
  era       TennisHistoryEra
  gender    TennisHistoryGender?

  eyebrow     String?
  title       String
  subtitle    String?
  description String?
  quote       String?
  achievement String?
  period      String?

  country     String?
  countryCode String?

  playerOne String?
  playerTwo String?
  players   String[] @default([])

  href String?

  imageUrl String?
  mediaId  String?
  media    MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  featured    Boolean          @default(false)
  status      MuseumPageStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([year])
  @@index([era])
  @@index([status])
  @@index([featured])
  @@index([sortOrder])
  @@index([mediaId])
  @@index([publishedAt])
  @@index([year, sortOrder])
}

model Collaboration {
  id        String @id @default(cuid())
  slug      String @unique
  sortOrder Int    @default(0)

  eyebrow     String?
  title       String
  subtitle    String?
  description String?
  story       String?

  partnerName String
  partnerType CollaborationPartnerType
  location    String?
  year        Int?
  period      String?

  projectTitle String?
  projectType  CollaborationProjectType?
  outcome      String?

  websiteUrl String?
  href       String?

  imageUrl String?
  mediaId  String?
  media    MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  featured    Boolean          @default(false)
  status      MuseumPageStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerName])
  @@index([partnerType])
  @@index([projectType])
  @@index([year])
  @@index([status])
  @@index([featured])
  @@index([sortOrder])
  @@index([mediaId])
  @@index([publishedAt])
  @@index([createdAt])
}

model MuseumCollection {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  eyebrow         String?
  title           String
  subtitle        String?
  description     String?
  type            CollectionType   @default(PLAYER)
  status          CollectionStatus @default(DRAFT)
  heroTitle       String?
  heroSubtitle    String?
  heroImageUrl    String?
  heroMediaId     String?
  primaryColor    String           @default("#C8FF00")
  secondaryColor  String           @default("#08111F")
  accentColor     String           @default("#FFFFFF")
  featured        Boolean          @default(false)
  displayOrder    Int?
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  heroMedia MediaAsset? @relation("MuseumCollectionHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)

  players   MuseumCollectionPlayer[]
  artifacts MuseumCollectionArtifact[]
  originals MuseumCollectionOriginal[]
  media     MuseumCollectionMedia[]

  @@index([name])
  @@index([type])
  @@index([status])
  @@index([featured])
  @@index([displayOrder])
  @@index([publishedAt])
  @@index([heroMediaId])
  @@index([createdAt])
}

model MuseumCollectionPlayer {
  id           String   @id @default(cuid())
  collectionId String
  playerId     String
  sortOrder    Int      @default(0)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())

  collection MuseumCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  player     Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([collectionId, playerId])
  @@index([collectionId])
  @@index([playerId])
  @@index([sortOrder])
}

model MuseumCollectionArtifact {
  id           String   @id @default(cuid())
  collectionId String
  artifactId   String
  sortOrder    Int      @default(0)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())

  collection MuseumCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  artifact   Artifact         @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([collectionId, artifactId])
  @@index([collectionId])
  @@index([artifactId])
  @@index([sortOrder])
}

model MuseumCollectionOriginal {
  id                String   @id @default(cuid())
  collectionId      String
  originalProductId String
  sortOrder         Int      @default(0)
  featured          Boolean  @default(false)
  createdAt         DateTime @default(now())

  collection      MuseumCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  originalProduct OriginalProduct  @relation(fields: [originalProductId], references: [id], onDelete: Cascade)

  @@unique([collectionId, originalProductId])
  @@index([collectionId])
  @@index([originalProductId])
  @@index([sortOrder])
}

model MuseumCollectionMedia {
  id           String   @id @default(cuid())
  collectionId String
  mediaAssetId String
  caption      String?
  sortOrder    Int      @default(0)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())

  collection MuseumCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([collectionId, mediaAssetId])
  @@index([collectionId])
  @@index([mediaAssetId])
  @@index([sortOrder])
}

model MuseumSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  group       String   @default("general")
  label       String?
  description String?
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@index([updatedAt])
}

model MuseumPage {
  id           String           @id @default(cuid())
  slug         String           @unique
  title        String
  eyebrow      String?
  subtitle     String?
  excerpt      String?
  content      String?
  heroImage    String?
  status       MuseumPageStatus @default(DRAFT)
  featured     Boolean          @default(false)
  displayOrder Int?

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  openGraphImage  String?
  robotsIndex     Boolean @default(true)
  robotsFollow    Boolean @default(true)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([featured])
  @@index([displayOrder])
  @@index([publishedAt])
  @@index([updatedAt])
}

model Tournament {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  shortName   String?
  category    TournamentCategory
  surface     CourtSurface
  city        String?
  country     String
  countryCode String?
  venue       String?

  foundedYear Int?
  description String?
  history     String?

  logoUrl    String?
  heroImage  String?
  websiteUrl String?

  active       Boolean @default(true)
  featured     Boolean @default(false)
  displayOrder Int?

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editions      TournamentEdition[]
  champions     TournamentChampion[]
  galleryItems  TournamentGalleryItem[]
  milestones    TournamentMilestone[]
  chapters      TournamentChapter[]
  iconicMoments TournamentIconicMoment[]
  artifacts     Artifact[]

  @@index([name])
  @@index([category])
  @@index([surface])
  @@index([country])
  @@index([active])
  @@index([featured])
  @@index([displayOrder])
}

model TournamentEdition {
  id           String @id @default(cuid())
  tournamentId String
  year         Int

  editionKey   String  @default("main")
  editionLabel String?

  startDate DateTime?
  endDate   DateTime?

  drawSize Int?

  championName String?
  runnerUpName String?

  championPlayerId String?
  runnerUpPlayerId String?

  championCountryCode String?
  runnerUpCountryCode String?

  score String?

  cancelled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  championPlayer Player?    @relation("TournamentEditionChampion", fields: [championPlayerId], references: [id], onDelete: SetNull)
  runnerUpPlayer Player?    @relation("TournamentEditionRunnerUp", fields: [runnerUpPlayerId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, year, editionKey])
  @@index([tournamentId])
  @@index([year])
  @@index([editionKey])
  @@index([championPlayerId])
  @@index([runnerUpPlayerId])
  @@index([cancelled])
}

model TournamentChampion {
  id           String @id @default(cuid())
  tournamentId String

  playerId String?

  name        String?
  country     String?
  countryCode String?

  titles Int @default(1)

  firstTitleYear Int?
  lastTitleYear  Int?
  titleYears     Int[] @default([])

  finals Int?
  wins   Int?

  legend    Boolean @default(false)
  featured  Boolean @default(false)
  sortOrder Int     @default(0)

  recordLabel String?
  quote       String?
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player?    @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@index([playerId])
  @@index([titles])
  @@index([legend])
  @@index([featured])
  @@index([sortOrder])
  @@index([name])
}

