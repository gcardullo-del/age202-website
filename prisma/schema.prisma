model Legend {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique
  gender LegendGender
  status LegendStatus @default(DRAFT)

  firstName   String?
  lastName    String?
  nickname    String?
  nationality String?
  countryCode String?
  birthDate   DateTime?
  birthPlace  String?
  deathDate   DateTime?
  era         String?
  turnedPro   Int?
  retiredYear Int?
  plays       String?
  backhand    String?

  heroImage      String?
  portraitImage  String?
  quote          String?
  biographyShort String?
  biographyLong  String?
  legacy         String?

  careerHigh     Int?
  careerTitles   Int  @default(0)
  grandSlams     Int  @default(0)
  australianOpen Int  @default(0)
  rolandGarros   Int  @default(0)
  wimbledon      Int  @default(0)
  usOpen         Int  @default(0)
  weeksAtNo1     Int  @default(0)
  yearEndNo1     Int  @default(0)
  olympicGold    Int  @default(0)

  displayOrder Int       @default(0)
  featured     Boolean   @default(false)
  publishedAt  DateTime?

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  openGraphImage  String?
  robotsIndex     Boolean @default(true)
  robotsFollow    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones LegendMilestone[]
  images     LegendImage[]

  @@index([gender])
  @@index([status])
  @@index([featured])
  @@index([displayOrder])
  @@index([name])
}

model LegendMilestone {
  id          String   @id @default(cuid())
  legendId    String
  year        Int
  title       String
  subtitle    String?
  description String?
  imageUrl    String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  legend Legend @relation(fields: [legendId], references: [id], onDelete: Cascade)

  @@index([legendId])
  @@index([year])
  @@index([sortOrder])
  @@index([featured])
}

enum LegendGender {
  MALE
  FEMALE
}

enum LegendStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LegendImage {
  id        String   @id @default(cuid())
  legendId  String
  url       String   @db.Text
  alt       String?
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  legend Legend @relation(fields: [legendId], references: [id], onDelete: Cascade)

  @@index([legendId])
  @@index([sortOrder])
}

model PushSubscription {
  id String @id @default(cuid())

  endpoint String @unique @db.Text
  p256dh   String @db.Text
  auth     String @db.Text

  userAgent String?
  enabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([createdAt])
}
