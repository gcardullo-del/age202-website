generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  country        String?
  biography      String?
  heroImage      String?
  portraitImage  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  accent         String               @default("#C8FF00")
  active         Boolean              @default(true)
  collectionType PlayerCollectionType @default(ARCHIVE)
  debutYear      Int?
  displayOrder   Int?
  firstName      String?
  lastName       String?
  nickname       String?
  quote          String?
  artifacts      Artifact[]
  atpPlayer      AtpPlayer?
  playerProfile  PlayerProfile?

  @@index([name])
  @@index([collectionType])
  @@index([displayOrder])
  @@index([active])
  @@index([debutYear])
}

model PlayerProfile {
  id               String    @id @default(cuid())
  playerId         String    @unique
  birthDate        DateTime?
  birthPlace       String?
  residence        String?
  height           Int?
  weight           Int?
  plays            String?
  backhand         String?
  coach            String?
  turnedPro        Int?
  careerHigh       Int?
  atpTitles        Int       @default(0)
  australianOpen   Int       @default(0)
  rolandGarros     Int       @default(0)
  wimbledon        Int       @default(0)
  usOpen           Int       @default(0)
  grandSlams       Int       @default(0)
  masters1000      Int       @default(0)
  atpFinals        Int       @default(0)
  olympicGold      Int       @default(0)
  davisCup         Int       @default(0)
  prizeMoney       Decimal?  @db.Decimal(15, 2)
  playingStyle     String?
  favouriteSurface String?
  biographyShort   String?
  biographyLong    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  player           Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Brand {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  logo      String?
  history   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  artifacts Artifact[]

  @@index([name])
}

model Artifact {
  id                String               @id @default(cuid())
  archiveNumber     String               @unique
  title             String
  slug              String               @unique
  description       String?
  year              Int?
  size              String?
  colour            String?
  material          String?
  condition         ArtifactCondition
  status            ArtifactStatus       @default(DRAFT)
  featured          Boolean              @default(false)
  playerId          String
  brandId           String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  authentic         Boolean              @default(false)
  authenticityCode  String?              @unique
  availability      ArtifactAvailability @default(COMING_SOON)
  category          ArtifactCategory?
  collection        String?
  curatorNote       String?
  currency          String               @default("EUR")
  edition           String?
  historicalContext String?
  metaDescription   String?
  metaTitle         String?
  museumStory       String?
  price             Decimal?             @db.Decimal(10, 2)
  publishedAt       DateTime?
  rarity            ArtifactRarity       @default(COMMON)
  season            String?
  subtitle          String?
  tags              String[]             @default([])
  tournament        String?
  vintage           Boolean              @default(false)
  vintedUrl         String?
  brand             Brand                @relation(fields: [brandId], references: [id])
  player            Player               @relation(fields: [playerId], references: [id])
  images            ArtifactImage[]
  certificate       Certificate?

  @@index([playerId])
  @@index([brandId])
  @@index([status])
  @@index([availability])
  @@index([category])
  @@index([rarity])
  @@index([featured])
  @@index([publishedAt])
  @@index([year])
  @@index([tournament])
  @@index([collection])
  @@index([createdAt])
}

model ArtifactImage {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  artifactId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@index([sortOrder])
  @@index([isCover])
}

model Certificate {
  id         String   @id @default(cuid())
  code       String   @unique
  issuedAt   DateTime @default(now())
  verified   Boolean  @default(true)
  curator    String?
  notes      String?
  qrCodeUrl  String?
  artifactId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([issuedAt])
  @@index([verified])
  @@index([createdAt])
}

model AtpPlayer {
  id           String  @id
  rank         Int
  previousRank Int?
  name         String
  firstName    String?
  lastName     String?
  slug         String  @unique
  country      String
  countryCode  String
  points       Int?
  age          Int?
  imageUrl     String?

  playerId String? @unique
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  rankingDate DateTime @default(now())
  source      String   @default("AGE202")
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rank])
  @@index([rank, active])
  @@index([active])
  @@index([countryCode])
  @@index([name])
  @@index([points])
  @@index([previousRank])
  @@index([rankingDate])
}

enum PlayerCollectionType {
  FEATURED
  LEGEND
  RISING_STAR
  ARCHIVE
}

enum ArtifactStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArtifactCondition {
  MINT
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
}

enum ArtifactCategory {
  SHIRT
  POLO
  JACKET
  SHORTS
  SHOES
  CAP
  ACCESSORY
}

enum ArtifactRarity {
  COMMON
  RARE
  VERY_RARE
  LEGENDARY
}

enum ArtifactAvailability {
  AVAILABLE
  SOLD
  COMING_SOON
  NOT_FOR_SALE
}
