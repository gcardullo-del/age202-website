generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  country         String?
  biography       String?
  heroImage       String?
  portraitImage   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  accent          String               @default("#C8FF00")
  active          Boolean              @default(true)
  collectionType  PlayerCollectionType @default(ARCHIVE)
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  openGraphImage  String?

  robotsIndex  Boolean @default(true)
  robotsFollow Boolean @default(true)

  publishedAt  DateTime?
  debutYear    Int?
  displayOrder Int?
  firstName    String?
  lastName     String?
  nickname     String?
  quote        String?

  artifacts         Artifact[]
  atpPlayer         AtpPlayer?
  playerProfile     PlayerProfile?
  careerEvents      PlayerCareerEvent[]
  museumCollections MuseumCollectionPlayer[]
  equipment         PlayerEquipment[]

  @@index([name])
  @@index([collectionType])
  @@index([displayOrder])
  @@index([active])
  @@index([debutYear])
}

model PlayerProfile {
  id               String    @id @default(cuid())
  playerId         String    @unique
  birthDate        DateTime?
  birthPlace       String?
  residence        String?
  height           Int?
  weight           Int?
  plays            String?
  backhand         String?
  coach            String?
  turnedPro        Int?
  careerHigh       Int?
  atpTitles        Int       @default(0)
  australianOpen   Int       @default(0)
  rolandGarros     Int       @default(0)
  wimbledon        Int       @default(0)
  usOpen           Int       @default(0)
  grandSlams       Int       @default(0)
  masters1000      Int       @default(0)
  atpFinals        Int       @default(0)
  olympicGold      Int       @default(0)
  davisCup         Int       @default(0)
  prizeMoney       Decimal?  @db.Decimal(15, 2)
  playingStyle     String?
  favouriteSurface String?
  biographyShort   String?
  biographyLong    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  player           Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model PlayerEquipment {
  id          String                  @id @default(cuid())
  playerId    String
  category    PlayerEquipmentCategory
  name        String
  brand       String?
  period      String?
  description String?
  curiosity   String?
  imageUrl    String?
  featured    Boolean                 @default(false)
  sortOrder   Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, category, name])
  @@index([playerId])
  @@index([category])
  @@index([featured])
  @@index([sortOrder])
}

model PlayerCareerEvent {
  id          String              @id @default(cuid())
  playerId    String
  year        Int
  month       Int?
  day         Int?
  title       String
  subtitle    String?
  description String?
  category    CareerEventCategory @default(MILESTONE)
  imageUrl    String?
  location    String?
  tournament  String?
  featured    Boolean             @default(false)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([playerId, year])
  @@index([playerId, sortOrder])
  @@index([category])
  @@index([featured])
  @@index([year])
}

model Brand {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  logo      String?
  history   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  artifacts Artifact[]

  @@index([name])
}

model Artifact {
  id                String                     @id @default(cuid())
  archiveNumber     String                     @unique
  title             String
  slug              String                     @unique
  description       String?
  year              Int?
  size              String?
  colour            String?
  material          String?
  condition         ArtifactCondition
  status            ArtifactStatus             @default(DRAFT)
  featured          Boolean                    @default(false)
  playerId          String
  brandId           String
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  authentic         Boolean                    @default(false)
  authenticityCode  String?                    @unique
  availability      ArtifactAvailability       @default(COMING_SOON)
  category          ArtifactCategory?
  collection        String?
  curatorNote       String?
  currency          String                     @default("EUR")
  edition           String?
  historicalContext String?
  metaDescription   String?
  metaTitle         String?
  museumStory       String?
  price             Decimal?                   @db.Decimal(10, 2)
  publishedAt       DateTime?
  rarity            ArtifactRarity             @default(COMMON)
  season            String?
  subtitle          String?
  tags              String[]                   @default([])
  tournament        String?
  vintage           Boolean                    @default(false)
  vintedUrl         String?
  brand             Brand                      @relation(fields: [brandId], references: [id])
  player            Player                     @relation(fields: [playerId], references: [id])
  images            ArtifactImage[]
  certificate       Certificate?
  museumCollections MuseumCollectionArtifact[]

  @@index([playerId])
  @@index([brandId])
  @@index([status])
  @@index([availability])
  @@index([category])
  @@index([rarity])
  @@index([featured])
  @@index([publishedAt])
  @@index([year])
  @@index([tournament])
  @@index([collection])
  @@index([createdAt])
}

model ArtifactImage {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  artifactId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@index([sortOrder])
  @@index([isCover])
}

model Certificate {
  id         String   @id @default(cuid())
  code       String   @unique
  issuedAt   DateTime @default(now())
  verified   Boolean  @default(true)
  curator    String?
  notes      String?
  qrCodeUrl  String?
  artifactId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([issuedAt])
  @@index([verified])
  @@index([createdAt])
}

model OriginalProduct {
  id                String                      @id @default(cuid())
  title             String
  subtitle          String?
  slug              String                      @unique
  description       String?
  collection        String?
  edition           String?
  category          OriginalProductCategory
  material          String?
  colour            String?
  sizes             String[]                    @default([])
  tags              String[]                    @default([])
  price             Decimal?                    @db.Decimal(10, 2)
  currency          String                      @default("EUR")
  vintedUrl         String?
  availability      OriginalProductAvailability @default(COMING_SOON)
  status            OriginalProductStatus       @default(DRAFT)
  featured          Boolean                     @default(false)
  displayOrder      Int?
  metaTitle         String?
  metaDescription   String?
  publishedAt       DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  images            OriginalProductImage[]
  museumCollections MuseumCollectionOriginal[]

  @@index([category])
  @@index([availability])
  @@index([status])
  @@index([featured])
  @@index([displayOrder])
  @@index([publishedAt])
  @@index([collection])
  @@index([createdAt])
}

model OriginalProductImage {
  id                String          @id @default(cuid())
  url               String
  alt               String?
  sortOrder         Int             @default(0)
  isCover           Boolean         @default(false)
  originalProductId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  originalProduct   OriginalProduct @relation(fields: [originalProductId], references: [id], onDelete: Cascade)

  @@index([originalProductId])
  @@index([sortOrder])
  @@index([isCover])
}

model AtpPlayer {
  id           String  @id
  rank         Int
  previousRank Int?
  name         String
  firstName    String?
  lastName     String?
  slug         String  @unique
  country      String
  countryCode  String
  points       Int?
  age          Int?
  imageUrl     String?

  playerId String? @unique
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  rankingDate DateTime @default(now())
  source      String   @default("AGE202")
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rank])
  @@index([rank, active])
  @@index([active])
  @@index([countryCode])
  @@index([name])
  @@index([points])
  @@index([previousRank])
  @@index([rankingDate])
}

model MediaFolder {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assets      MediaAsset[]

  @@index([name])
  @@index([createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  title        String
  alt          String?
  originalName String
  url          String
  mimeType     String
  extension    String
  size         Int
  width        Int?
  height       Int?
  tags         String[] @default([])
  folderId     String?
  isUsed       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  folder             MediaFolder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  heroForCollections MuseumCollection[]      @relation("MuseumCollectionHeroMedia")
  museumCollections  MuseumCollectionMedia[]

  @@index([title])
  @@index([originalName])
  @@index([mimeType])
  @@index([extension])
  @@index([folderId])
  @@index([isUsed])
  @@index([createdAt])
}

model MuseumCollection {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  eyebrow         String?
  title           String
  subtitle        String?
  description     String?
  type            CollectionType   @default(PLAYER)
  status          CollectionStatus @default(DRAFT)
  heroTitle       String?
  heroSubtitle    String?
  heroImageUrl    String?
  heroMediaId     String?
  primaryColor    String           @default("#C8FF00")
  secondaryColor  String           @default("#08111F")
  accentColor     String           @default("#FFFFFF")
  featured        Boolean          @default(false)
  displayOrder    Int?
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  heroMedia MediaAsset? @relation("MuseumCollectionHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)

  players   MuseumCollectionPlayer[]
  artifacts MuseumCollectionArtifact[]
  originals MuseumCollectionOriginal[]
  media     MuseumCollectionMedia[]

  @@index([name])
  @@index([type])
  @@index([status])
  @@index([featured])
  @@index([displayOrder])
  @@index([publishedAt])
  @@index([heroMediaId])
  @@index([createdAt])
}

model MuseumCollectionPlayer {
  id           String   @id @default(cuid())
  collectionId String
  playerId     String
  sortOrder    Int      @default(0)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())

  collection MuseumCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  player     Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([collectionId, playerId])
  @@index([collectionId])
  @@index([playerId])
  @@index([sortOrder])
}

model MuseumCollectionArtifact {
  id           String   @id @default(cuid())
  collectionId String
  artifactId   String
  sortOrder    Int      @default(0)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())

  collection MuseumCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  artifact   Artifact         @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([collectionId, artifactId])
  @@index([collectionId])
  @@index([artifactId])
  @@index([sortOrder])
}

model MuseumCollectionOriginal {
  id                String   @id @default(cuid())
  collectionId      String
  originalProductId String
  sortOrder         Int      @default(0)
  featured          Boolean  @default(false)
  createdAt         DateTime @default(now())

  collection      MuseumCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  originalProduct OriginalProduct  @relation(fields: [originalProductId], references: [id], onDelete: Cascade)

  @@unique([collectionId, originalProductId])
  @@index([collectionId])
  @@index([originalProductId])
  @@index([sortOrder])
}

model MuseumCollectionMedia {
  id           String   @id @default(cuid())
  collectionId String
  mediaAssetId String
  caption      String?
  sortOrder    Int      @default(0)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())

  collection MuseumCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([collectionId, mediaAssetId])
  @@index([collectionId])
  @@index([mediaAssetId])
  @@index([sortOrder])
}

model MuseumSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  group       String   @default("general")
  label       String?
  description String?
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@index([updatedAt])
}

model MuseumPage {
  id           String           @id @default(cuid())
  slug         String           @unique
  title        String
  eyebrow      String?
  subtitle     String?
  excerpt      String?
  content      String?
  heroImage    String?
  status       MuseumPageStatus @default(DRAFT)
  featured     Boolean          @default(false)
  displayOrder Int?

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  openGraphImage  String?
  robotsIndex     Boolean @default(true)
  robotsFollow    Boolean @default(true)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([featured])
  @@index([displayOrder])
  @@index([publishedAt])
  @@index([updatedAt])
}

enum MuseumPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlayerCollectionType {
  FEATURED
  LEGEND
  RISING_STAR
  ARCHIVE
}

enum CareerEventCategory {
  DEBUT
  RANKING
  TITLE
  GRAND_SLAM
  MASTERS_1000
  ATP_FINALS
  OLYMPICS
  DAVIS_CUP
  RIVALRY
  COMEBACK
  RETIREMENT
  MILESTONE
  OTHER
}

enum ArtifactStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArtifactCondition {
  MINT
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
}

enum ArtifactCategory {
  SHIRT
  POLO
  JACKET
  SHORTS
  SHOES
  CAP
  ACCESSORY
}

enum ArtifactRarity {
  COMMON
  RARE
  VERY_RARE
  LEGENDARY
}

enum ArtifactAvailability {
  AVAILABLE
  SOLD
  COMING_SOON
  NOT_FOR_SALE
}

enum OriginalProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OriginalProductAvailability {
  AVAILABLE
  SOLD
  COMING_SOON
  NOT_FOR_SALE
}

enum OriginalProductCategory {
  TSHIRT
  POLO
  HOODIE
  SWEATSHIRT
  CAP
  BOTTLE
  BAG
  POSTER
  ACCESSORY
  OTHER
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CollectionType {
  PLAYER
  ERA
  TOURNAMENT
  THEME
  BRAND
  OTHER
}

enum PlayerEquipmentCategory {
  RACQUET
  STRINGS
  SHOES
  APPAREL
  BAG
  ACCESSORY
  OTHER
}
